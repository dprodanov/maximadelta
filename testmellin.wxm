find_gammas(e) := if atom(e) then []
  else if op(e) = gamma then [e]
  else listify(setify(flatten(map(find_gammas, args(e)))))$

split_sum_parity(term, nn) := block(
  [gs, al, bl, q, m, c, lo, hi, dead, parts: [], arg, k],
  gs: find_gammas(denom(term)),
  if gs = [] then return('sum(term, nn, 0, inf)),
  al: [], bl: [],
  for g in gs do (
    arg: expand(part(g, 1)),
    al: endcons(coeff(arg, nn, 1), al),
    bl: endcons(coeff(arg, nn, 0), bl)),
  if not every(ratnump, append(al, bl)) then return('sum(term, nn, 0, inf)),
  q: q: lreduce(lcm, map(denom, al), 1),
  for r: 0 thru q - 1 do (
    lo: 0, hi: inf, dead: false,
    for i thru length(gs) do (
      m: al[i]*q,
      c: al[i]*r + bl[i],
      if m = 0 then (if integerp(c) and c <= 0 then dead: true)
      elseif integerp(c) then (
        if m < 0 then hi: min(hi, ceiling(c/(-m)) - 1)
        else lo: max(lo, floor(-c/m) + 1))),
    if not dead and (hi = inf or hi >= lo) then
      parts: endcons('sum(subst(q*k + r, nn, term), k, lo, hi), parts)),
  apply("+", parts))$
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
mellin_inv_gamma(F, s, x, c) := block(
  [fam, p, A, B, G, term, lterms: [], rterms: [], nn, L, R],
  fam: find_gamma_pole_families(F, s, nn),
  if fam = [] or length(fam) # length(setify(fam)) then return(false),
  for eq in fam do (
    p: rhs(eq),
    if freeof(nn, p) then (
      term: residue(F*x^(-s), s, p),
      if is(p < c) then lterms: endcons(term, lterms)
      else rterms: endcons(-term, rterms))
    else (
      A: ratsimp(-1/diff(p, nn)),
      B: ratsimp(-nn - A*p),
      G:  subst(p, s, F/gamma(A*s + B)),
      term: split_sum_parity((-1)^nn/(A*nn!)*G*x^(-p), nn),
      if is(A > 0) then lterms: endcons(term, lterms)
      else rterms: endcons(-term, rterms))),
  L: apply("+", lterms),
  R: apply("+", rterms),
  if rterms = [] then L                       /* heuristic: left series only */
  elseif lterms = [] then R
  else L*unit_step(1-x) + R*unit_step(x-1))$
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
S1:mellin_inv_gamma(gamma(s)/gamma(1+s/2), s, x, 1/2);
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
simplify_sum((sum(((-1)^(2*k+1)*x^(2*k+1))/((2*k+1)!*gamma(1-(2*k+1)/2)),k,0,inf)));
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
find_gammas(e) := if atom(e) then []
  else if op(e) = gamma then [e]
  else listify(setify(flatten(map(find_gammas, args(e)))))$

split_sum_parity(term, nn) := block(
  [gs, al, bl, q, m, c, lo, hi, dead, parts: [], arg, k, tr],
  declare(k, integer),
  gs: find_gammas(denom(term)),
  if gs = [] then return('sum(term, nn, 0, inf)),
  al: [], bl: [],
  for g in gs do (
    arg: expand(part(g, 1)),
    al: endcons(coeff(arg, nn, 1), al),
    bl: endcons(coeff(arg, nn, 0), bl)),
  if not every(ratnump, append(al, bl)) then return('sum(term, nn, 0, inf)),
  q: lreduce(lcm, map(denom, al), 1),
  for r: 0 thru q - 1 do (
    lo: 0, hi: inf, dead: false,
    for i thru length(gs) do (
      m: al[i]*q,
      c: al[i]*r + bl[i],
      if m = 0 then (if integerp(c) and c <= 0 then dead: true)
      elseif integerp(c) then (
        if m < 0 then hi: min(hi, ceiling(c/(-m)) - 1)
        else lo: max(lo, floor(-c/m) + 1))),
    if not dead and (hi = inf or hi >= lo) then (
      tr: subst(q*k + r, nn, term),
      for i thru length(gs) do (
        m: al[i]*q,
        c: al[i]*r + bl[i],
        if not integerp(c) then
          tr: subst(subst(q*k + r, nn, gs[i])
                    = %pi/(sin(%pi*c)*(-1)^(m*k)*gamma(1 - (m*k + c))), tr)),
      parts: endcons('sum(tr, k, lo, hi), parts))),
  apply("+", parts))$
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */

/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
S1:mellin_inv_gamma(gamma(s)/gamma(1+s/2), s, x, 1/2);
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
assume(x>0);
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
simplify_sum(S1);
/* [wxMaxima: input   end   ] */
/* [wxMaxima: input   start ] */
mellinn(erf(x/2), x, s);
/* [wxMaxima: input   end   ] */
/* [wxMaxima: question  start ] */
<math><st>Is </st><mi lisp="*var-tag*">s</mi><mo>+</mo><mn>1</mn><st> positive, negative or zero?</st></math>
/* [wxMaxima: question  end   ] */
/* [wxMaxima: answer  start ] */
pos;
/* [wxMaxima: answer  end   ] */
/* [wxMaxima: question  start ] */
<math><st>Is </st><mi lisp="*var-tag*">s</mi><st> an </st><mi lisp="*var-tag*">integer</mi><st>?</st></math>
/* [wxMaxima: question  end   ] */
/* [wxMaxima: answer  start ] */
no;
/* [wxMaxima: answer  end   ] */
/* [wxMaxima: input   start ] */
mellin_inv_gamma(gamma(s)^2, s, x, 1);
/* [wxMaxima: input   end   ] */

