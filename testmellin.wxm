mellin_inv_rational(F, s, x, c) := block([n, d, poles, rl:0, rr:0, v, re_v, res],
  F: ratsimp(F),
  [n, d]: [expand(num(F)), expand(denom(F))],
  if hipow(n, s) >= hipow(d, s) then return(false),
  poles: map(rhs, solve(d, s)),
  for v in poles do (
    re_v: realpart(v),
    if not numberp(float(re_v)) then return(false),
    res: residue(F*x^(-s), s, v),
    if is(re_v < c) then rl: rl + res
    elseif is(re_v > c) then rr: rr + res
    else return(false)),
  [rl, -rr])$
