find_gamma_pole_families(expr_in, s, n) := block(
  [num_G, den_G, rest_den, pole_families: [], A, B, hit, k],
  [num_G, den_G]: get_gamma_parts(expr_in, s),
  rest_den: copylist(den_G),
  for ab in num_G do (
    A: first(ab),
    B: second(ab),
    hit: false,
    for dd in rest_den while hit = false do
      if is(ratsimp(A - first(dd)) = 0) and integerp(ratsimp(B - second(dd)))
        then hit: dd,
    if hit = false then
      pole_families: endcons(s = (-n - B)/A, pole_families)
    else (
      rest_den: delete(hit, rest_den, 1),
      k: ratsimp(B - second(hit)),
      if k < 0 then
        for j: 0 thru -k - 1 do
          pole_families: endcons(s = (-j - B)/A, pole_families))),
  pole_families)$
