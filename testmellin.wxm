mellin_inv_gamma(F, s, x, c) := block(
  [fam, p, A, B, G, term, lterms: [], rterms: [], nn, L, R],
  fam: find_gamma_pole_families(F, s, nn),
  if fam = [] or length(fam) # length(setify(fam)) then return(false),
  for eq in fam do (
    p: rhs(eq),
    if freeof(nn, p) then (
      term: residue(F*x^(-s), s, p),
      if is(p < c) then lterms: endcons(term, lterms)
      else rterms: endcons(-term, rterms))
    else (
      A: ratsimp(-1/diff(p, nn)),
      B: ratsimp(-nn - A*p),
      G: minfactorial(makefact(subst(p, s, F/gamma(A*s + B)))),
      term: 'sum((-1)^nn/(A*nn!)*G*x^(-p), nn, 0, inf),
      if is(A > 0) then lterms: endcons(term, lterms)
      else rterms: endcons(-term, rterms))),
  L: apply("+", lterms),
  R: apply("+", rterms),
  if rterms = [] then L                       /* heuristic: left series only */
  elseif lterms = [] then R
  else L*unit_step(1-x) + R*unit_step(x-1))$
